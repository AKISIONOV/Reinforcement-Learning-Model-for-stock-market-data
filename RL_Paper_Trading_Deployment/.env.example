# Alpaca Paper Trading API Credentials
# Replace the placeholders below with your actual keys from your Alpaca Dashboard
APCA_API_KEY_ID=YOUR_ALPACA_API_KEY_ID
APCA_API_SECRET_KEY=YOUR_ALPACA_API_SECRET_KEY
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Trading Execution Configuration
# Supported modes: paper (Alpaca Paper Trading) | mock (Local Mock Execution)
TRADING_MODE=paper
